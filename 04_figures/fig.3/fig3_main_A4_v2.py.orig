"""Figure 3, assembled as ONE Nature-Medicine main figure on an A4 page.

Panel order requested by the author: fig3i, fig3b, fig3a, fig3d, fig3e, fig3f,
fig3g  ->  re-lettered a-g in that reading order.  Declarative panel titles are
dropped; the legend is set below the panels.  Type sizes are the manuscript's
own three-size scheme (8 pt axis labels, 7 pt annotation/legend, 6 pt ticks),
identical in every panel.

Outputs (all at 400 dpi / vector):
  fig3_main_A4.png   fig3_main_A4.pdf   fig3_main_A4.pptx (editable text layer)

    python fig3_main_A4.py
"""
import os, sys, textwrap
import numpy as np
import pandas as pd
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
from matplotlib.lines import Line2D
from matplotlib.ticker import MaxNLocator

FIGDIR = "/Users/yunman/Desktop/submission/revision/text/figures"
HERE = os.path.join(FIGDIR, "fig.3")
sys.path.insert(0, os.path.join(FIGDIR, "fig_color"))
from np_dtb_style import (apply_np_style, panel, C, LW, TICK_PT, ANNOT_PT,
                          LABEL_PT, enforce)
from fig_export import collect_text_records
sys.path.insert(0, FIGDIR)
import figA4_kit as K              # frozen internal-distribution rules

D = os.path.join(HERE, "fig3_data")
DPI = 400
WITH_CAP = "--no-caption" not in sys.argv        # python fig3_main_A4.py --no-caption
STEM = "fig3_main_A4_v2" if WITH_CAP else "fig3_main_A4_v2_nocaption"
apply_np_style()
matplotlib.rcParams["savefig.bbox"] = None          # keep the A4 canvas exact

# Legibility pass: the manuscript's 6/7/8 pt scheme raised two steps to 8/9/10 pt
# (panel letters 11 pt bold, caption 8 pt), keeping ONE size per role.
TICK_PT, ANNOT_PT, LABEL_PT = 8, 9, 10
LETTER_PT, CAP_PT = 11, 8
matplotlib.rcParams.update({
    'axes.labelsize': LABEL_PT, 'axes.titlesize': LABEL_PT,
    'xtick.labelsize': TICK_PT, 'ytick.labelsize': TICK_PT,
    'legend.fontsize': ANNOT_PT, 'font.size': ANNOT_PT,
})
CUR_W, CUR_ROWLAB = 180.0, True      # set by the layout loop before each panel
CUR_PLOT_H = 22.0                    # axes height of the build in progress

# ----------------------------------------------------------------- shared keys
BUILDS7 = ['3m_268', '10m_268', '10m_1000', '10m_own', '10m', '100m', '1b']
BENCH = ['SAR', 'RWW']
BLAB = {'3m_268': '3 M\n268', '10m_268': '10 M\n268', '10m_1000': '10 M\n1000',
        '10m_own': '10 M\nvoxel', '10m': '10 M\nvoxel', '100m': '100 M\nvoxel',
        '1b': '1 B\nvoxel', 'SAR': 'SAR', 'RWW': 'rWW'}
BHYP = {'3m_268': '3 M\n268', '10m_268': '3 M\n268', '10m_1000': '10 M\n1000',
        '10m_own': '10 M\nvoxel', '10m': '100 M\nvoxel', '100m': '100 M\nvoxel',
        '1b': '100 M\nvoxel', 'SAR': '', 'RWW': ''}
BFAM = {**{k: 'regional' for k in ('3m_268', '10m_268', '10m_1000')},
        **{k: 'voxel' for k in ('10m_own', '10m', '100m', '1b')},
        'SAR': 'benchmark', 'RWW': 'benchmark'}
WBKEY = {'10m': '10m_voxel', '100m': '100m_voxel', '1b': '1b_voxel'}
def keep_lw(artist, factor):
    """Tag an artist so enforce_v2 restores its weight after the style sweep."""
    for a in (artist if isinstance(artist, (list, tuple)) else [artist]):
        try:
            a.set_gid(f"keep:{factor}")
        except AttributeError:
            pass
    return artist


def enforce_v2(f):
    """House sweep, then re-apply the data marks' own weights."""
    enforce(f)
    for a in f.findobj():
        g = a.get_gid() if hasattr(a, "get_gid") else None
        if isinstance(g, str) and g.startswith("keep:"):
            a.set_linewidth(float(g.split(":")[1]) * LW)


def vivid(c, sat=1.0, lum=1.0):
    """Same hue, more chroma: the manuscript tokens read washed out at 6-8 pt
    marker sizes, so each series colour is saturated and slightly darkened
    here. Hue is untouched, so every token keeps its identity."""
    import colorsys
    from matplotlib import colors as mcol
    h, li, sa = colorsys.rgb_to_hls(*mcol.to_rgb(c))
    return colorsys.hls_to_rgb(h, min(1., li * lum), min(1., sa * sat))


FAM = {'regional': vivid(C('model_regional'), 1.35, .96),
       'voxel': vivid(C('model_voxel'), 1.40, 1.02),
       'benchmark': vivid(C('hc'), 1.0, .92)}
DRUG = {'ampa': C('ampa'), 'gaba': C('gaba')}   # e and f keep the
                                               # manuscript tokens, so
                                               # Fig. 3 matches Fig. 4-5
DRUG_LAB = {'ampa': 'AMPA', 'gaba': 'GABA-A'}
SUBJ_MK = {'HC01': 'o', 'MDD': 's', 'AUD': '^'}
SUBJ_LS = {'HC01': (0, (2.6, 1.7)), 'MDD': '-', 'AUD': '-'}
SUBJ_OPEN = {'HC01': True, 'MDD': False, 'AUD': False}
SWEEP_MARK = {'ampa': 0.0044, 'gaba': 0.0040}   # setting marked in panel e
SUBJ_LAB = {'HC01': 'HC', 'MDD': 'MDD', 'AUD': 'AUD'}   # legend wording
ROWLAB = []                                     # (axes, row-label text)
COND = ['SST Stop Success', 'SST Stop Failure', 'MID Reward Antici.', 'MID Pos. Feedback']
CMK = {'SST Stop Success': 'o', 'SST Stop Failure': 's',
       'MID Reward Antici.': '^', 'MID Pos. Feedback': 'D'}

a3 = pd.read_csv(f'{D}/fig3a_mse_per_subject.csv')
wb = pd.read_csv(f'{D}/fig3b_wholebrain_fc_crossscale.csv')
c3 = pd.read_csv(f'{D}/fig3d_run_to_run_sd.csv')
d3 = pd.read_csv(f'{D}/fig3e_ampa_sweep.csv')
e3 = pd.read_csv(f'{D}/fig3f_gaba_sweep.csv')
gg = pd.read_csv(f'{D}/fig3g_delta_np_seven_models.csv')
bi = pd.read_csv(f'{D}/fig3i_assimilated_bold_r.csv')


def hyper_row(ax, keys, y_mm):
    """Second tick row, y_mm BELOW the axes (mm, not axes fractions -- panels
    differ in height).  Adjacent builds that share a hyperparameter set are
    labelled once over their span, with a rule.  The row's name is parked at
    the panel's left edge here and aligned after the draw (see ROWLAB)."""
    pos = ax.get_position()
    h_mm, w_mm = pos.height * PH, pos.width * PW
    y = -y_mm / h_mm
    tr = ax.get_xaxis_transform()
    first = None
    i = 0
    while i < len(keys):
        lab, j = BHYP[keys[i]], i
        while j + 1 < len(keys) and BHYP[keys[j + 1]] == lab:
            j += 1
        if lab:
            if j > i:
                off = .55 / h_mm                     # 0.55 mm, any axes height
                ax.plot([i, j], [y + off] * 2, transform=tr, color='0.75',
                        lw=LW, clip_on=False, solid_capstyle='butt')
            t = ax.text((i + j) / 2, y, lab, transform=tr, ha='center',
                        va='top', fontsize=TICK_PT, color='0.35',
                        clip_on=False)
            first = first or t
        i = j + 1
    if CUR_ROWLAB:
        # x in AXES fractions (tr blends data-x with axes-y, so it cannot be
        # used here): -LAB_L/(CUR_W-LAB_L) is exactly the panel's left edge.
        ROWLAB.append((ax, ax.text(
            -LAB_L / (CUR_W - LAB_L), y, 'assimilated\nhyperparameters',
            transform=ax.transAxes, ha='left', va='top', fontsize=TICK_PT,
            color='0.35', clip_on=False), first))


def block_bands(ax, keys, y, n_bench=0):
    n_reg = sum(1 for k in keys if BFAM[k] == 'regional')
    n_dtb = sum(1 for k in keys if BFAM[k] != 'benchmark')
    ax.axvline(n_reg - .5, color='0.85', lw=LW, zorder=0)
    if n_bench:
        ax.axvline(n_dtb - .5, color='0.85', lw=LW, zorder=0)
    ax.text((n_reg - 1) / 2, y, 'regional models', ha='center', fontsize=ANNOT_PT,
            color=TEXTCOL['regional'], fontweight='bold')
    ax.text((n_reg + n_dtb - 1) / 2, y, 'voxel models', ha='center',
            fontsize=ANNOT_PT, color=TEXTCOL['voxel'], fontweight='bold')
    if n_bench:
        ax.text(n_dtb + (n_bench - 1) / 2, y, 'benchmarks', ha='center',
                fontsize=ANNOT_PT, color='0.30', fontweight='bold')


def _dark(c, f=.62):
    """Darker shade of a colour, for marker edges."""
    import colorsys
    from matplotlib import colors as mcol
    h, l, sat = colorsys.rgb_to_hls(*mcol.to_rgb(c))
    return colorsys.hls_to_rgb(h, max(0., l * f), sat)


def _wash(c, f=.30):        # f = how much of the colour the wash keeps
    from matplotlib import colors as mcol
    rgb = np.array(mcol.to_rgb(c))
    return tuple(1 - f * (1 - rgb))


# 9 pt labels beside saturated marks read washed out at the patch colour, so
# every text use of a family colour takes a darkened version of it.
TEXTCOL = {k: _dark(v, .74) for k, v in FAM.items()}


def box_strip(ax, values, colour, width=.52, jitter=.13, seed=0):
    rng = np.random.default_rng(seed)
    bp = ax.boxplot(values, positions=np.arange(len(values)), widths=width,
                    showfliers=False, patch_artist=True)
    for el in ('boxes', 'whiskers', 'caps', 'medians'):
        for art in bp[el]:
            art.set_linewidth(LW); art.set_color('black')
            if el == 'boxes':
                art.set_edgecolor('black')
    for i, v in enumerate(values):
        bp['boxes'][i].set_facecolor(_wash(colour[i], .16))
        ax.scatter(i + rng.uniform(-jitter, jitter, len(v)), v, s=4.8,
                   facecolor=colour[i], edgecolor='none',
                   alpha=.80, zorder=3)


def build_ticks(ax, keys, hyp_mm):
    ax.set_xticks(range(len(keys)))
    ax.set_xticklabels([BLAB[k] for k in keys], fontsize=TICK_PT)
    for t, k in zip(ax.get_xticklabels(), keys):
        t.set_color(TEXTCOL[BFAM[k]] if BFAM[k] != 'benchmark' else '0.30')
    hyper_row(ax, keys, hyp_mm)


# ------------------------------------------------------------------- panels a-g
def panel_a(ax):                       # was fig3i - assimilated-region BOLD r
    MK = {'MID': 'o', 'SST': 's'}
    rng = np.random.default_rng(5)
    for i, m in enumerate(BUILDS7):
        col = FAM[BFAM[m]]
        sub = bi[bi.model == m]
        for tk in ('MID', 'SST'):
            v = sub[sub.task == tk].bold_r.values
            dx = -.16 if tk == 'MID' else .16
            ax.scatter(i + dx + rng.uniform(-.05, .05, len(v)), v, s=9.0,
                       marker=MK[tk], facecolor=_wash(col, .55),
                       edgecolor=col, linewidth=LW * .9, alpha=1.0, zorder=3)
            keep_lw(ax.hlines(v.mean(), i + dx - .15, i + dx + .15, color=col,
                              lw=LW * 2.6, zorder=4), 2.6)
    ax.set_ylabel('Assimilated-region\nBOLD ($r$)')   # (r) as in panel b
    ax.axhline(.9, color='0.6', lw=LW, ls=(0, (2.6, 2.0)), zorder=0)
    ax.set_ylim(.55, 1.0)
    ax.set_yticks([.6, .7, .8, .9, 1.0])
    build_ticks(ax, BUILDS7, HYP_MM)
    block_bands(ax, BUILDS7, 1.03)      # above the top tick, outside the axes
    hM = [Line2D([], [], marker=MK[t], linestyle='none', markersize=3.2,
                 markerfacecolor='0.45', markeredgecolor='0.25',
                 markeredgewidth=LW * .8)
          for t in ('MID', 'SST')]
    ax.legend(hM, ['MID', 'SST'], loc='lower right',
              ncol=2, fontsize=ANNOT_PT, handletextpad=.3, columnspacing=1.2,
              borderpad=0, frameon=False)


def panel_b(ax):                       # was fig3b - whole-brain FC similarity
    WBM = [WBKEY.get(m, m) for m in BUILDS7] + BENCH
    WKEY = BUILDS7 + BENCH
    xw = np.arange(len(WBM))
    dx = np.linspace(-.20, .20, len(COND))
    for k, cond in enumerate(COND):
        sub = wb[wb.condition == cond].set_index('model').loc[WBM]
        for i, m in enumerate(WBM):
            col = FAM[BFAM[WKEY[i]]]
            eb = ax.errorbar(
                        xw[i] + dx[k], sub.r_mean.iloc[i], yerr=sub.r_sd.iloc[i],
                        fmt=CMK[cond], color=col, markersize=3.2, lw=0,
                        elinewidth=LW * 1.7, capsize=2.0, capthick=LW * 1.7,
                        markerfacecolor=col, markeredgecolor=_dark(col),
                        markeredgewidth=LW * .8, zorder=3)
            keep_lw(list(eb[1]) + list(eb[2]), 1.7)
    ax.set_ylabel('Whole-brain FC\nsimilarity ($r$)')
    ax.set_ylim(0, .82)
    ax.yaxis.set_major_locator(MaxNLocator(5))
    build_ticks(ax, WKEY, HYP_MM)
    block_bands(ax, WKEY, .78, n_bench=len(BENCH))


def panel_c(ax):                       # was fig3a - simulation error
    AMOD = BUILDS7 + BENCH
    vals = [a3.loc[a3.model == m, 'mse'].values for m in AMOD]
    box_strip(ax, vals, [FAM[BFAM[m]] for m in AMOD])
    top = max(a3.mse) * 1.30
    ax.set_ylabel('Simulation error\nof NP (MSE)')
    ax.set_ylim(0, top)
    ax.yaxis.set_major_locator(MaxNLocator(5))
    build_ticks(ax, AMOD, HYP_MM)
    block_bands(ax, AMOD, top * .90, n_bench=len(BENCH))


def panel_d(ax):                       # was fig3d - run-to-run variability
    BUILDS_REP = [m for m in BUILDS7 if m != '10m_own']
    c = c3.set_index('model').loc[BUILDS_REP].reset_index()
    x = np.arange(len(c))
    dcol = [FAM[BFAM[m]] for m in c.model]
    ax.bar(x, c.run_sd_mean.fillna(0), width=.58,
           facecolor=[(*matplotlib.colors.to_rgb(k), .80) for k in dcol],
           edgecolor=[_dark(k) for k in dcol], linewidth=LW, zorder=2)
    for xi, m, sd, col in zip(x, c.run_sd_mean, c.run_sd_sd, dcol):
        if np.isfinite(m):
            eb = ax.errorbar(xi, m, yerr=sd, fmt='none', ecolor=_dark(col),
                             elinewidth=LW * 1.7, capsize=2.2,
                             capthick=LW * 1.7, zorder=3)
            keep_lw(list(eb[1]) + list(eb[2]), 1.7)
    top = float((c.run_sd_mean + c.run_sd_sd).max()) * 1.22
    ax.set_ylabel('Run-to-run s.d.\nof NP factor')
    ax.set_ylim(0, top)
    ax.yaxis.set_major_locator(MaxNLocator(5))
    build_ticks(ax, list(c.model), HYP_MM)
    block_bands(ax, list(c.model), top * .93)


def panel_sweeps(axes):
    """The two conductance sweeps stacked: AMPA above, GABA-A below, one
    sub-axes each on a common y scale.  The first column of each is the twin's
    own unperturbed baseline (the same value in both); the GABA-A settings
    themselves are applied on top of the AMPA perturbation.  Colour marks the
    perturbation, marker and dash pattern mark the twin."""
    ylo, yhi = -2.0, 2.0
    for ax, df_, dkey in zip(axes, (d3, e3), ('ampa', 'gaba')):
        levels = list(df_.columns[1:])
        xs = np.arange(len(levels))
        for _, row in df_.iterrows():
            sj = row['subject']
            keep_lw(ax.plot(
                    xs, row[levels].astype(float).values, color=DRUG[dkey],
                    marker=SUBJ_MK[sj], markersize=3.2, lw=LW * 2.0,
                    ls=SUBJ_LS[sj],
                    markerfacecolor='white' if SUBJ_OPEN[sj] else DRUG[dkey],
                    markeredgecolor=_dark(DRUG[dkey]), markeredgewidth=LW,
                    clip_on=False, zorder=3), 2.0)
        ax.set_xticks(xs)
        ax.set_xticklabels(['baseline'] + [f'{float(v):g}' for v in levels[1:]],
                           rotation=90, ha='center', va='top', fontsize=TICK_PT)
        ax.set_ylabel('Simulated\nNP factor')   # two lines: one would overhang the sub-axes
        ax.get_xticklabels()[0].set_ha('left')
        hit = [k for k, v in enumerate(levels) if k and
               abs(float(v) - SWEEP_MARK[dkey]) < 1e-9]
        if hit:
            ax.axvline(hit[0], color=DRUG[dkey], lw=LW, ls=(0, (2.2, 1.8)),
                       zorder=1)
            ax.get_xticklabels()[hit[0]].set_fontweight('bold')
        ax.set_xlim(-.4, len(levels) - .6)
        ax.set_ylim(ylo, yhi)
        ax.set_yticks(np.arange(ylo, yhi + .01, 1.0))
        ax.text(.99, .03, DRUG_LAB[dkey], transform=ax.transAxes, ha='right',
                va='bottom', fontsize=ANNOT_PT, color=DRUG[dkey])
    axes[-1].set_xlabel('Conductance')
    hs = [Line2D([], [], color='0.35', marker=SUBJ_MK[sj], ls=SUBJ_LS[sj],
                 markersize=2.8, lw=LW, markeredgecolor='0.35',
                 markerfacecolor='white' if SUBJ_OPEN[sj] else '0.35')
          for sj in ('HC01', 'MDD', 'AUD')]
    axes[0].legend(hs, [SUBJ_LAB[sj] for sj in ('HC01', 'MDD', 'AUD')],
                   loc='lower center',
                   bbox_to_anchor=(.5, 1.0), ncol=3, fontsize=ANNOT_PT,
                   handletextpad=.4, columnspacing=1.0, borderpad=0,
                   frameon=False)


def panel_g(ax):                       # was fig3g - delta NP across builds
    rng = np.random.default_rng(2)
    off = {'ampa': -.18, 'gaba': .18}
    for drug in ['ampa', 'gaba']:
        for i, m_ in enumerate(BUILDS7):
            v = gg[(gg.drug == drug) & (gg.model == m_)].delta.values
            ax.scatter(i + off[drug] + rng.uniform(-.06, .06, len(v)), v, s=15,
                       facecolor=DRUG[drug], edgecolor=_dark(DRUG[drug]),
                       linewidth=LW * .8, alpha=1.0, zorder=3)
            keep_lw(ax.hlines(v.mean(), i + off[drug] - .15, i + off[drug] + .15,
                              color='black', lw=LW * 2.2, zorder=4), 2.2)
    ax.axhline(0, color='0.6', lw=LW, ls=(0, (2.6, 1.7)), zorder=1)
    ax.set_ylabel('$\\Delta$ NP (perturbed\n$-$ baseline)')
    ax.set_xlim(-.55, len(BUILDS7) - .45)
    ymax = float(gg.delta.max())
    ax.set_ylim(float(gg.delta.min()) - .3, ymax * 1.28)
    ax.yaxis.set_major_locator(MaxNLocator(5))
    build_ticks(ax, BUILDS7, HYP_MM)
    block_bands(ax, BUILDS7, ymax * 1.12)
    handles = [Line2D([], [], marker='o', linestyle='none', markersize=4,
                      markerfacecolor=DRUG[d], markeredgecolor=_dark(DRUG[d]),
                      markeredgewidth=LW * .8)
               for d in ['ampa', 'gaba']]
    ax.legend(handles, [DRUG_LAB[d] for d in ['ampa', 'gaba']], loc='lower center',
              bbox_to_anchor=(.5, 1.0), ncol=2, fontsize=ANNOT_PT,
              handletextpad=.4, columnspacing=1.2, borderpad=0, frameon=False)


# --------------------------------------------------------------- page geometry
# Internal distribution is the frozen kit ruleset (figA4_kit): 6 mm letter band,
# 6 mm between rows, letters seated 0.9 mm above / 1.0 mm left of their OWN
# panel's measured content.  The axes height is then solved so the page is
# filled exactly and never overrun.
PW, PH = K.PW, K.PH
ML, MR, MT, MB = K.ML, K.MR, K.MT, K.MB
LAB_L = 18.0                       # width reserved for y label + y ticks
XBLOCK = 16.5                      # space under the axes for the two tick rows
XBLOCK_SWEEP = 17.5                # vertical ticks + x label
LETTER_BAND, LETTER_PAD, LETTER_PADX = K.LETTER_BAND, K.LETTER_PAD, K.LETTER_PADX
GAP, GAPX = K.GAP, K.GAPX
HYP_MM = 8.8                       # hyperparameter row, mm below the axes

# Four rows, two columns: the four panels that carry the seven builds plus the
# double tick row take the wide left slot, the three compact panels stack in the
# narrow right slot.  Letters follow reading order, so the drawing functions are
# no longer named after their letter: b = whole-brain FC, c = run-to-run s.d.,
# d = simulation error, e = AMPA sweep, f = delta NP, g = GABA-A sweep.
COL_W, COL_N = 102.0, 73.0
STACK_TICK = 13.5          # rotated 'baseline' tick of an upper sub-axes
# Four rows, letters in the original reading order (the two sweeps are one
# panel e, so delta NP is f).  Row 4 is DOUBLE height: e stacks its two sweeps
# there, f takes the whole row height.  A 6th element in a panel spec is its
# number of vertically stacked sub-axes.
ROWS = [[("a", panel_a, ML, PW - ML - MR, XBLOCK)],
        [("b", panel_b, ML, PW - ML - MR, XBLOCK)],
        [("c", panel_c, ML, COL_W, XBLOCK),
         ("d", panel_d, ML + COL_W + GAPX, COL_N, XBLOCK)],
        [("e", panel_sweeps, ML, COL_N, XBLOCK_SWEEP, 2),
         ("f", panel_g, ML + COL_N + GAPX, COL_W, XBLOCK)]]
ROW_SUB = [max(r[5] if len(r) > 5 else 1 for r in row) for row in ROWS]
NROW = len(ROWS)
XB_SUM = sum(max(r[4] for r in row) for row in ROWS)
NAX = sum(ROW_SUB)                     # axes heights down the page
STACK_SUM = STACK_TICK * sum(n - 1 for n in ROW_SUB)


def build(plot_h, shift=None):
    """Lay the rows out at axes height `plot_h`; a row whose panels stack n
    sub-axes is n * plot_h + (n-1) * STACK_TICK tall.  `shift` pushes single
    panels down by mm so the CONTENT tops within a row sit on one line."""
    global CUR_W, CUR_ROWLAB, CUR_PLOT_H
    CUR_PLOT_H = plot_h
    ROWLAB.clear()
    shift = shift or {}
    f = plt.figure(figsize=panel(PW, PH))
    out, y = [], MT
    for row, nrow in zip(ROWS, ROW_SUB):
        top = y + LETTER_BAND
        rh = nrow * plot_h + (nrow - 1) * STACK_TICK
        for spec in row:
            ch, fn, x_mm, w_mm, xblock = spec[:5]
            nsub = spec[5] if len(spec) > 5 else 1
            dy = shift.get(ch, 0.0)
            CUR_W, CUR_ROWLAB = w_mm, ch in ("a", "b")       # c has no room for it:
            #  its hyperparameter labels start 3.5 mm inside the frame, so the
            #  row name could only fit by eating the panel letter's gutter
            if nsub > 1:
                axl = [K.axes_mm(f, x_mm + LAB_L,
                                 top + dy + k * (plot_h + STACK_TICK),
                                 w_mm - LAB_L, plot_h) for k in range(nsub)]
                fn(axl)
            else:
                axl = [K.axes_mm(f, x_mm + LAB_L, top + dy, w_mm - LAB_L, rh)]
                fn(axl[0])
            out.append(dict(ch=ch, x=x_mm, axes=axl,
                            txt=K.letter(f, x_mm, top - 1.2, ch)))
        y = (top + max(shift.get(r[0], 0.0) for r in row) + rh
             + max(r[4] for r in row) + GAP)
    enforce_v2(f)
    return f, out, y - GAP


# ------------------------------------------------------------------- caption
CAP_TITLE = "Fig. 3 | Multiscale validation of the digital twin brain."
CAP = [
    ("", "Seven DTB builds are compared throughout; they differ in the number of simulated "
         "neurons, the neuron count of the assimilated hyperparameter set and the spatial "
         "resolution of the simulation target, so every panel carries a second tick row naming "
         "the hyperparameter set, labelled once per set with a rule spanning the builds that "
         "share it. Colour encodes model family (regional versus voxel) only; benchmarks (SAR, rWW) "
         "are grey. "),
    ("a", ", Pearson correlation between simulated and measured BOLD within the assimilated "
          "regions (MID, 51 Shen labels; SST, 47), averaged over assimilated voxels; one subject "
          "× task session, 24 points per build, bar, group mean; two-sided paired t tests, "
          "n = 24, uncorrected. "),
    ("b", ", whole-brain FC similarity, mean ± s.d. across the 12 twins of the correlation "
          "between simulated and measured FC (23,436 edges among 217 nodes), per task condition "
          "(marker shape); n = 12 per point; descriptive. "),
    ("c", ", simulation error of the 12-edge NP profile against one empirical reference (FC "
          "recomputed from the simulated voxels); median, 25th\u201375th percentiles, 1.5 \u00d7 IQR "
          "whiskers, all 12 twins overplotted; paired t tests, df = 11, uncorrected. Benchmarks "
          "are scored against the Shen-268 task FC their coupling was fitted to and are not on "
          "the DTB scale. "),
    ("d", ", run-to-run variability: mean across twins of the within-subject s.d. of the NP factor "
          "over 5 repeats; error bars, s.d. across twins; the single-run 10 M voxel "
          "own-hyperparameter build is omitted; descriptive. "),
    ("e", ", NP factor across the AMPA (upper; 9 settings, 0.0020\u20130.0052) and GABA-A (lower; "
          "5 settings, 0.0020\u20130.0040) conductance sweeps in three twins (HC, MDD, AUD), stacked. The "
          "first column of each segment is that twin's own unperturbed baseline, the same value in "
          "both segments; the GABA-A settings themselves are applied on top of the AMPA "
          "perturbation, as in f. Colour marks the perturbation, marker and dash pattern the twin; "
          "vertical dashed line and bold tick, AMPA 0.0044 and GABA-A 0.0040; descriptive only, no "
          "test at n = 3. "),
    ("f", ", change in summed NP after AMPA and after GABA-A perturbation in all seven builds; "
          "points, twins; bar, group mean; n = 12 per build \u00d7 perturbation; two-sided one-sample "
          "t tests against zero, df = 11, Benjamini\u2013Hochberg FDR across the 14 tests. Only the "
          "two 268-region builds survive correction, and only under GABA-A; GABA-A is applied on "
          "top of AMPA."),
]


def rich_lines(fig, runs, width_mm, size_pt, renderer):
    """Greedy word wrap over (text, bold) runs; returns lines of placed segments."""
    words = []
    for txt, bold in runs:
        for w in txt.split(" "):
            if w:
                words.append((w, bold))
    def wpx(s, bold):
        t = fig.text(0, 0, s, fontsize=size_pt,
                     fontweight="bold" if bold else "normal")
        w = t.get_window_extent(renderer=renderer).width
        t.remove()
        return w / fig.dpi * 25.4
    space = wpx(" ", False)
    lines, cur, cw = [], [], 0.0
    for w, bold in words:
        ww = wpx(w, bold)
        if cur and cw + space + ww > width_mm:
            lines.append(cur); cur, cw = [], 0.0
        cur.append((w, bold, ww))
        cw += ww + (space if len(cur) > 1 else 0)
    if cur:
        lines.append(cur)
    return lines, space


runs = [(CAP_TITLE + " ", True)]
for lab, seg in CAP:
    if lab:
        runs.append((lab + ",", True))
        seg = seg[1:] if seg.startswith(",") else seg
    runs.append((seg, False))
CAP_W = PW - ML - MR
LH = K.CAP_LH

# pass 1 -- measure each panel's content overhang and the caption height
_f0, _p0, _ = build(22.0)
_over = K.overhangs(_f0, _p0)
_l0 = (rich_lines(_f0, runs, CAP_W, CAP_PT, _f0.canvas.get_renderer())[0]
       if WITH_CAP else [])
plt.close(_f0)

CAP_H = (K.CAP_GAP + len(_l0) * LH + 1.0) if WITH_CAP else 0.0
FIXED = (MT + NROW * LETTER_BAND + XB_SUM + (NROW - 1) * GAP + STACK_SUM
         + sum(max(_over[r[0]] for r in row) for row in ROWS))
PLOT_H = (PH - MB - CAP_H - FIXED) / NAX     # fill the page, never overrun it

# pass 2 -- push each panel down by its own overhang so the rows read flush
fig, PANELS, BOTTOM = build(PLOT_H, _over)
fig.canvas.draw()                    # y label positions are only final now
_rend = fig.canvas.get_renderer()
_MM = lambda px: px / fig.dpi * 25.4
GUT = K.LETTER_W + K.LETTER_PADX      # the letter keeps its own gutter: the
                                      # row label may not yield into it

# e sits under a, b and c but its tick labels are narrower, so matplotlib
# parks its y label further right and the column's labels step in and out.
# align_left_ink moves each label out to the column's widest label block, so
# all four start their ink on one line (and the letters line up with them).
_by = {p["ch"]: p for p in PANELS}
_labx = lambda a: _MM(a.yaxis.label.get_window_extent(renderer=_rend).x0)
_line = min(_labx(_by[ch]["axes"][0])
            for ch in ("a", "b", "c"))          # a, b, c stay where they are
for _sub in _by["e"]["axes"]:                   # only e moves on to that line
    for _ in range(4):                          # a rotated label's anchor is
        _d = _labx(_sub) - _line                # not its bbox edge, so close
        if abs(_d) < .05:                       # the loop on the measured
            break                               # edge instead
        _lab, _pos = _sub.yaxis.label, _sub.get_position()
        _px, _py = _lab.get_position()
        _sub.yaxis.set_label_coords(
            (_px - _d / 25.4 * fig.dpi - _pos.x0 * fig.bbox.width)
            / (_pos.width * fig.bbox.width), _py)
        fig.canvas.draw()
_rend = fig.canvas.get_renderer()

for _ax, _t, _first in ROWLAB:        # in to the y label, clear of the row
    _pos = _ax.get_position()
    _lx = _MM(_ax.yaxis.label.get_window_extent(renderer=_rend).x0)
    _w = _MM(_t.get_window_extent(renderer=_rend).width)
    _lim = (_MM(_first.get_window_extent(renderer=_rend).x0) - 1.8
            if _first is not None else 1e9)
    _x = _lx if _lx + _w <= _lim else max(_pos.x0 * PW - LAB_L + GUT,
                                         _lim - _w)
    _t.set_x((_x - _pos.x0 * PW) / (_pos.width * PW))
print("y-label left edge (mm): " + ", ".join(
    f"{ch} " + "/".join(f"{_labx(a):.2f}" for a in _by[ch]["axes"])
    for ch in ("a", "b", "c", "e")))
K.place_letters(fig, PANELS)

renderer = fig.canvas.get_renderer()
cap_objs, cap_rect = [], None
lines, space = (rich_lines(fig, runs, CAP_W, CAP_PT, renderer) if WITH_CAP
                else ([], 0))
cap_top = BOTTOM + K.CAP_GAP
for i, line in enumerate(lines):
    x = ML
    yy = cap_top + i * LH
    for word, bold, ww in line:
        t = fig.text(x / PW, 1 - (yy + LH * 0.78) / PH, word, fontsize=CAP_PT,
                     fontweight="bold" if bold else "normal", va="baseline",
                     ha="left")
        cap_objs.append(t)
        x += ww + space
CAP_BOTTOM = cap_top + len(lines) * LH
if WITH_CAP:
    cap_rect = (ML, cap_top - 0.5, CAP_W, CAP_BOTTOM - cap_top + 2)

assert CAP_BOTTOM <= PH - 0.5, f"content overruns A4: {CAP_BOTTOM:.1f} mm"
print(f"[{STEM}] axes height {PLOT_H:.1f} mm; panels end at {BOTTOM:.1f} mm; "
      f"caption {len(lines)} lines -> {CAP_BOTTOM:.1f} mm of {PH:.0f} mm")

# ----------------------------------------------------------------------- export
png = os.path.join(HERE, STEM + ".png")
pdf = os.path.join(HERE, STEM + ".pdf")
ppt = os.path.join(HERE, STEM + ".pptx")
fig.savefig(png, dpi=DPI, bbox_inches=None, facecolor="white")
fig.savefig(pdf, bbox_inches=None, facecolor="white")


def export_pptx(fig, path, caption_objs, caption_runs, cap_rect, dpi=DPI):
    """Raster graphics layer + one native text box per label, caption as ONE box."""
    from pptx import Presentation
    from pptx.util import Inches, Pt
    from pptx.dml.color import RGBColor
    from pptx.enum.text import PP_ALIGN, MSO_ANCHOR, MSO_AUTO_SIZE
    from matplotlib import colors as mcolors

    recs = [r for r in collect_text_records(fig) if r["obj"] not in caption_objs]
    fw, fh = [float(v) for v in fig.get_size_inches()]
    fdpi = float(fig.dpi)
    vis = [(t, t.get_visible()) for t in fig.findobj(matplotlib.text.Text)]
    for t, _ in vis:
        t.set_visible(False)
    bg = os.path.splitext(path)[0] + "_bg.png"
    fig.savefig(bg, dpi=dpi, bbox_inches=None, facecolor=fig.get_facecolor())
    for t, v in vis:
        t.set_visible(v)

    prs = Presentation()
    prs.slide_width, prs.slide_height = Inches(fw), Inches(fh)
    slide = prs.slides.add_slide(prs.slide_layouts[6])
    slide.shapes.add_picture(bg, 0, 0, width=Inches(fw), height=Inches(fh))
    align = {"left": PP_ALIGN.LEFT, "center": PP_ALIGN.CENTER, "right": PP_ALIGN.RIGHT}
    pad = 1.25
    for r in recs:
        w, h = r["w"] * pad / fdpi, r["h"] * pad / fdpi
        left, top = r["cx"] / fdpi - w / 2.0, (fh - r["cy"] / fdpi) - h / 2.0
        box = slide.shapes.add_textbox(Inches(left), Inches(top), Inches(w), Inches(h))
        tf = box.text_frame
        tf.word_wrap = False
        tf.auto_size = MSO_AUTO_SIZE.NONE
        tf.vertical_anchor = MSO_ANCHOR.MIDDLE
        tf.margin_left = tf.margin_right = tf.margin_top = tf.margin_bottom = 0
        p = tf.paragraphs[0]
        p.alignment = align.get(r["ha"], PP_ALIGN.CENTER)
        run = p.add_run()
        run.text = r["text"].replace("$", "").replace("\\Delta", "Δ").replace("\\", "")
        f = run.font
        f.name = "Arial"; f.size = Pt(r["size"])
        f.bold = r["weight"] in ("bold", "semibold", "heavy", "black")
        f.italic = r["style"] in ("italic", "oblique")
        f.color.rgb = RGBColor(*[int(round(255 * c)) for c in mcolors.to_rgb(r["color"])])
        if r["rot"]:
            box.rotation = (-r["rot"]) % 360.0
    # caption: a single editable, word-wrapped text box
    if cap_rect is None:
        prs.save(path); os.remove(bg); return path
    x_mm, y_mm, w_mm, h_mm = cap_rect
    box = slide.shapes.add_textbox(Inches(x_mm / 25.4), Inches(y_mm / 25.4),
                                   Inches(w_mm / 25.4), Inches(h_mm / 25.4))
    tf = box.text_frame
    tf.word_wrap = True
    tf.margin_left = tf.margin_right = tf.margin_top = tf.margin_bottom = 0
    p = tf.paragraphs[0]
    p.alignment = PP_ALIGN.LEFT
    for text, bold in caption_runs:
        run = p.add_run()
        run.text = text
        run.font.name = "Arial"; run.font.size = Pt(CAP_PT); run.font.bold = bold
    prs.save(path)
    os.remove(bg)
    return path


export_pptx(fig, ppt, set(cap_objs), runs, cap_rect)
bad = [t.get_text() for t in fig.findobj(matplotlib.text.Text)
       if t.get_text().strip() and t.get_fontname() != "Arial"]
print("non-Arial text:", bad[:5], "| files:", [os.path.basename(p) for p in (png, pdf, ppt)])
plt.close(fig)
