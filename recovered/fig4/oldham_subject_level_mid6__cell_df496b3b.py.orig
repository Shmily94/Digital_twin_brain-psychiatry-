 oldham(bm, am, 'mid6_ampa', DS, 'baseline \u2192 AMPA', 'AMPA up-regulation'),
 oldham(bm, gm, 'mid6_gaba', DS, 'baseline \u2192 GABA-A', 'GABA-A up-regulation'),
 oldham(b12s:=S[['baseline_%s'%e for e in ALL12]].to_numpy(float).sum(1), S[['ampa__mod_%s'%e for e in ALL12]].to_numpy(float).sum(1), 'np12_ampa', DS, 'baseline \u2192 AMPA', 'AMPA up-regulation'),
 oldham(b12s, S[['gaba__mod_%s'%e for e in ALL12]].to_numpy(float).sum(1), 'np12_gaba', DS, 'baseline \u2192 GABA-A', 'GABA-A up-regulation'),
])
