def oldham(pre, post, label, dataset, contrast, drug):
    m = (pre+post)/2; d = post-pre; n = len(pre)
    r, p = stats.pearsonr(m, d); df = n-2
    t = r*np.sqrt(df/(1-r**2))
    z = np.arctanh(r); lo, hi = np.tanh(z-1.96/np.sqrt(n-3)), np.tanh(z+1.96/np.sqrt(n-3))
    rn, pn = stats.pearsonr(pre, d)
    f = sm.OLS(post, sm.add_constant(pre)).fit(); ci = f.conf_int()[1]; tv = (f.params[1]-1)/f.bse[1]
    return dict(series=label, dataset=dataset, contrast=contrast, drug_or_perturbation=drug, n=n,
                pre_mean=pre.mean(), post_mean=post.mean(), pre_sd=pre.std(ddof=1), post_sd=post.std(ddof=1),
                variance_ratio_post_pre=post.var(ddof=1)/pre.var(ddof=1),
                oldham_r=r, oldham_ci95_lo=lo, oldham_ci95_hi=hi, oldham_t=t, df=df, oldham_p=p,
                naive_baseline_change_r=rn, naive_p=pn, slope_post_on_pre=f.params[1],
                slope_ci95_lo=ci[0], slope_ci95_hi=ci[1], slope_vs1_t=tv,
                slope_vs1_p=2*(1-stats.t.cdf(abs(tv), f.df_resid)))
DS = 'DTB model (IMAGEN, n = 288)'
