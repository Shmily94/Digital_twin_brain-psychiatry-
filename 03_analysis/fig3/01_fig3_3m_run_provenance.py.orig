FIG=R+'figures/'
SUB='/Users/yunman/Desktop/submission/'
D3=FIG+'fig.3/fig3_data/'
FR=pd.read_csv(SUB+'revision/10m_voxel_population_simulation/analysis_results/fc_similarity_four_runs_per_subject.csv')
ES=SUB+'revision/model_scale_consistent/add_new_subjects/empirical_fc_voxel_used_model/'
MT=matload(ES+'simu_real_FC_across_scales_12subs.mat')
cn=[str(x) for x in np.atleast_1d(MT['condition_names']).ravel()]
CORD=['SST_stop_success','SST_stop_failure','MID_antici_hit','MID_feed_hit']
FB=np.asarray(MT['fc_corr_dtb_voxels'])
CORD=['SST_stop_success','SST_stop_failure','MID_antici_hit','MID_feed_hit']
ci=[cn.index(c) for c in CORD]
K6=['3m_268','10m_268','10m_1000','10m_voxel','100m_voxel','1b_voxel']
LAB6={'3m_268':'3 M / 268','10m_268':'10 M / 268','10m_1000':'10 M / 1000',
      '10m_voxel':'10 M voxel, 100 M hyper','100m_voxel':'100 M voxel','1b_voxel':'1 B voxel'}
subj=[int(x) for x in np.atleast_1d(MT['subject_ids']).ravel()]
PB=pd.DataFrame({LAB6[s]:np.nanmean(FB[:,ci,si],axis=1) for si,s in enumerate(K6)}, index=subj)
PB['10 M voxel, 10 M hyper']=FR.set_index('sub_id')['r_dtb_voxels__10m_own_params'].reindex(PB.index).values
