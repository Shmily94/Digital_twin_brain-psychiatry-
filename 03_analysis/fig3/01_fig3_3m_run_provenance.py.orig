PB['rWW']=P_rWW.reindex(PB.index).values
NR=SUB+'revision/model_scale_consistent/manuscript_numbers_newflow/3m_model_new_run/'
import h5py
f=h5py.File(NR+'Baseline_simulated_3m_task_FC.mat','r')
def cell(si,ti,ri,sj): return np.asarray(f[f['task_fc_Z'][si,ti,ri,sj]][:])
MIDA=[1,3,5]
MIDF=[2,4,6]
def newrun_fc(sj):
    out={}
    out['MID_antici_hit']=np.mean([np.mean([cell(s,0,r,sj) for s in MIDA],axis=0) for r in range(5)],axis=0)
    out['MID_feed_hit']  =np.mean([np.mean([cell(s,0,r,sj) for s in MIDF],axis=0) for r in range(5)],axis=0)
    out['SST_stop_success']=np.mean([cell(2,1,r,sj) for r in range(5)],axis=0)
    out['SST_stop_failure']=np.mean([cell(3,1,r,sj) for r in range(5)],axis=0)
    return out
RB=np.asarray(MT['real_fc_dtb_voxels'])
iu=np.triu_indices(217,1)
res={}
for cnd in CORD:
    j=cn.index(cnd); rs=[]
    for sj in range(12):
        sim=newrun_fc(sj)[cnd][iu]; emp=RB[:,:,sj,j][iu]
        m=np.isfinite(sim)&np.isfinite(emp); rs.append(np.corrcoef(sim[m],emp[m])[0,1])
    res[cnd]=np.array(rs)

# ---- computation: recovered from execution-log cell 89e53249
newFC=np.column_stack([res[c] for c in CORD]).mean(axis=1)
old=PB['3 M / 268'].values
rows=[dict(panel='Fig. 3a / Table S10 (NP-edge MSE)',quantity='3M/268 MSE, reference B',
      old_run='0.0851 (six_model_mse_12subs.csv)',new_run='0.0649',used_in_figure='NEW run',verdict='CORRECT'),
 dict(panel='Fig. 3b / Table S9 (whole-brain FC)',quantity='3M/268 whole-brain r, reference B',
      old_run=f'{old.mean():.4f} ± {old.std(ddof=1):.4f}',new_run=f'{newFC.mean():.4f} ± {newFC.std(ddof=1):.4f}',
      used_in_figure='OLD run',verdict='MISMATCH')]
CK=pd.DataFrame(rows)
CK.to_csv(D3+'fig3_3m_run_provenance.csv',index=False)
