mid=slice(6,12)
def match(A,B):
    C=np.array([[np.corrcoef(A[i],B[j])[0,1] for j in range(12)] for i in range(12)])
    ri,ci=linear_sum_assignment(-C); return np.diag(C).mean(),C[ri,ci].mean(),ci
