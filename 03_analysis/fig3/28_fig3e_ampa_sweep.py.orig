def parts(A,B):
    ep=np.corrcoef(A.mean(0),B.mean(0))[0,1]
    ra=A-A.mean(0)-A.mean(1,keepdims=True)+A.mean(); rb=B-B.mean(0)-B.mean(1,keepdims=True)+B.mean()
    return np.corrcoef(A.ravel(),B.ravel())[0,1],ep,np.corrcoef(ra.ravel(),rb.ravel())[0,1]
