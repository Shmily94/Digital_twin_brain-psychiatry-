def pair(a,b,la,lb):
    s=pd.DataFrame({'a':PB[a].values,'b':PB[b].values}).dropna()
    d=s.a-s.b; n=len(s); t,p=st.ttest_rel(s.a,s.b); se=d.std(ddof=1)/np.sqrt(n)
    ci=st.t.ppf(.975,n-1)*se
    return dict(contrast=f'{la} vs {lb}',n=n,mean_diff=round(d.mean(),4),
        ci95=f'[{d.mean()-ci:+.4f}, {d.mean()+ci:+.4f}]',t=round(t,3),df=n-1,
        p=float(f'{p:.3g}'),dz=round(d.mean()/d.std(ddof=1),2),n_pos=int((d>0).sum()))
