D24=pd.DataFrame(rows,columns=[h or 'c%d'%i for i,h in enumerate(hdr)])
print(D24.shape)
m=D24.apply(lambda r:' | '.join(str(x) for x in r if x is not None),axis=1)
for i,s in enumerate(m):
