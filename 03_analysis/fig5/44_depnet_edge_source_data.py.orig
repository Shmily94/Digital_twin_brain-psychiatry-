def ids_v1(M,key='unique_name'):
    raw=M[key]; return np.array([str(raw[i,0].flat[0]).strip().lstrip("'").lstrip('0') or '0' for i in range(raw.shape[0])])
def ids_v2(M,key='unique_name'):
    raw=M[key]; return np.array([str(raw[0,i][0]).strip().lstrip("'").split('_')[-1].lstrip('0') or '0' for i in range(raw.shape[1])])
