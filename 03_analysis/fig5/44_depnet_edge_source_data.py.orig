# ---------------------------------------------------------------- cell 42711582 (cell_index 389)
import statsmodels.formula.api as smf
DN=T4[T4.Group2.isin(['HC','MDD'])].copy()
DN['MDD']=(DN.Group2=='MDD').astype(int)
print('n =', len(DN), DN.Group2.value_counts().to_dict())
chk=[]
for c in ['empirical','simulated','ampa','gaba']:
    mod=smf.ols(f'{c} ~ MDD + sex + C(recruitmentSite) + headmotion',data=DN).fit()
    chk.append((c, round(float(mod.params['MDD']),4), round(float(mod.tvalues['MDD']),3),
                float(f"{mod.pvalues['MDD']:.3g}"), int(mod.df_resid)))
for r in chk: print(r)
print('\nSI reports: empirical t=-4.98, simulated t=-5.13, AMPA t=-0.97, GABA t=-2.78 (df 136)')

